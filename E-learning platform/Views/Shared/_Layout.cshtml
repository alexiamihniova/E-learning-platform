<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="E-Learn.Pro — Platforma premium de educație online. Cursuri de programare, design și business cu experți de top." />
    <title>@ViewData["Title"] — E-Learn.Pro</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap + Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/E_learning_platform.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- ── NAVIGATION ─────────────────────── -->
    <header>
        <nav class="glass-nav">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center">
                    <!-- Logo -->
                    <a class="text-decoration-none d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                        <div style="width:32px;height:32px;background:linear-gradient(135deg,#0062ff,#6c5ce7);border-radius:9px;display:flex;align-items:center;justify-content:center;">
                            <i class="bi bi-mortarboard-fill text-white" style="font-size:.9rem;"></i>
                        </div>
                        <span style="font-weight:900;font-size:1.2rem;color:white;letter-spacing:-.03em;">
                            E-LEARN<span class="text-gradient">.PRO</span>
                        </span>
                    </a>

                    <!-- Desktop links -->
                    <div class="d-none d-lg-flex align-items-center">
                        <a class="nav-link-custom" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="nav-link-custom" asp-controller="Courses" asp-action="Index">Courses</a>
                        <a class="nav-link-custom" asp-controller="Patterns" asp-action="Index">Patterns Demo</a>
                        <a class="nav-link-custom" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        <a class="btn-premium ms-4 py-2 px-4" asp-controller="Courses" asp-action="Index"
                           style="font-size:.9rem;">
                            <i class="bi bi-rocket-takeoff me-1"></i> Get Started
                        </a>
                    </div>

                    <!-- Mobile toggle -->
                    <button id="navToggler" class="nav-toggler d-lg-none" aria-label="Toggle menu">
                        <i class="bi bi-list"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile menu -->
            <div id="mobileMenu" class="mobile-menu">
                <div class="container">
                    <a class="nav-link-custom" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="nav-link-custom" asp-controller="Courses" asp-action="Index">Courses</a>
                    <a class="nav-link-custom" asp-controller="Patterns" asp-action="Index">Patterns Demo</a>
                    <a class="nav-link-custom" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    <div class="px-3 pt-2 pb-3">
                        <a class="btn-premium d-block text-center" asp-controller="Courses" asp-action="Index">Get Started</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- ── MAIN CONTENT ───────────────────── -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ── FOOTER ─────────────────────────── -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row g-5 mb-5">
                <!-- Brand -->
                <div class="col-lg-4">
                    <div class="footer-brand">
                        E-LEARN<span class="text-gradient">.PRO</span>
                    </div>
                    <p class="text-secondary" style="font-size:.92rem;line-height:1.7;max-width:300px;">
                        Empowering students worldwide with next-generation online education. Premium content, expert instructors, real results.
                    </p>
                    <div class="d-flex gap-2 mt-4">
                        <a href="#" class="social-icon"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-github"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <!-- Links -->
                <div class="col-6 col-lg-2">
                    <h6 class="text-white fw-700 mb-3" style="font-size:.8rem;letter-spacing:.08em;">PLATFORM</h6>
                    <a asp-controller="Courses" asp-action="Index" class="footer-link">All Courses</a>
                    <a asp-controller="Patterns" asp-action="Index" class="footer-link">Patterns Demo</a>
                    <a asp-controller="Dashboard" asp-action="Index" class="footer-link">Dashboard</a>
                    <a href="#" class="footer-link">Mentors</a>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="text-white fw-700 mb-3" style="font-size:.8rem;letter-spacing:.08em;">COMPANY</h6>
                    <a href="#" class="footer-link">About Us</a>
                    <a href="#" class="footer-link">Careers</a>
                    <a href="#" class="footer-link">Blog</a>
                    <a href="#" class="footer-link">Contact</a>
                </div>

                <!-- Newsletter -->
                <div class="col-lg-4">
                    <h6 class="text-white fw-700 mb-3" style="font-size:.8rem;letter-spacing:.08em;">NEWSLETTER</h6>
                    <p class="text-secondary" style="font-size:.88rem;">Get the latest courses and updates delivered to your inbox.</p>
                    <div class="d-flex gap-2 mt-3">
                        <input type="email" class="form-control form-control-dark flex-grow-1"
                               placeholder="your@email.com" style="border-radius:10px;">
                        <button class="btn-premium py-2 px-3" style="white-space:nowrap;font-size:.85rem;">
                            Subscribe
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bottom bar -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center
                        border-top pt-4 gap-3" style="border-color:var(--border) !important;">
                <p class="text-secondary mb-0" style="font-size:.84rem;">
                    &copy; 2026 E-Learn.Pro. Built with ❤️ using C# &amp; ASP.NET Core.
                </p>
                <div class="d-flex gap-3">
                    <a href="#" class="footer-link mb-0" style="font-size:.84rem;">Privacy</a>
                    <a href="#" class="footer-link mb-0" style="font-size:.84rem;">Terms</a>
                    <a href="#" class="footer-link mb-0" style="font-size:.84rem;">Cookies</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
